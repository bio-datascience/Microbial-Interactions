library(tidyverse)
library(readxl)
library(clusterProfiler)
# Read the data
cluster_df <- read_excel("../data/cluster_analysis/clusters.xlsx")
# adapt colnames
colnames(cluster_df) <- paste0("C",colnames(cluster_df))
# pivot wider
cluster_df <- cluster_df %>%
pivot_longer(cols = colnames(cluster_df),
names_to = "cluster_number",
values_to = "locus_tag") %>%
dplyr::filter(!is.na(locus_tag))
n_genes <- cluster_df %>%
group_by(cluster_number) %>%
summarise(n_genes = n())
enrichment_KEGG <- function(cluster_id, enrichment_function, organism_code = "cje", cluster_info=cluster_df, minGSize = 10){
# Gather cluster genes
cluster_genes <- cluster_info %>%
dplyr::filter(cluster_number == cluster_id) %>%
select(locus_tag) %>%
unlist()
# GSEA on kegg
kk <- enrichment_function(gene = cluster_genes,
organism = organism_code,
minGSSize=minGSize)
# Determine if results
if(is.null(kk)){
return(NULL)
}
# Gather and filter result
kk_result <- kk@result %>%
mutate(cluster_number = cluster_id)
# Return result
return(kk_result)
}
gse_KEGG <- function(cluster_id, enrichment_function, organism_code = "cje", cluster_info=cluster_df, minGSize = 10){
# Gather cluster genes
cluster_genes <- cluster_info %>%
dplyr::filter(cluster_number == cluster_id) %>%
select(locus_tag) %>%
unlist()
# GSEA on kegg
kk <- enrichment_function(geneList = cluster_genes,
organism = organism_code,
minGSSize = minGSize)
# Determine if results
if(is.null(kk)){
return(NULL)
}
# Gather and filter result
kk_result <- kk@result %>%
mutate(cluster_number = cluster_id)
# Return result
return(kk_result)
}
# Cluster names
cnames <- cluster_df %>%
select(cluster_number) %>%
distinct() %>%
unlist()
kegg_enrichement_all <- bind_rows(lapply(cnames, enrichment_KEGG, enrichment_function=enrichKEGG))
kegg_enrichement_significant <- kegg_enrichement_all %>%
group_by(cluster_number) %>%
dplyr::filter(p.adjust <= 0.05) %>%
left_join(n_genes, by="cluster_number") %>%
select(cluster_number, n_genes, ID, Description, GeneRatio, BgRatio, pvalue, p.adjust, qvalue, geneID, Count)
mkegg_enrichement_all <- bind_rows(lapply(cnames, enrichment_KEGG, enrichment_function=enrichMKEGG, minGSize=5))
mkegg_enrichement_significant <- mkegg_enrichement_all %>%
group_by(cluster_number) %>%
dplyr::filter(p.adjust <= 0.05) %>%
left_join(n_genes, by="cluster_number") %>%
select(cluster_number, n_genes, ID, Description, GeneRatio, BgRatio, pvalue, p.adjust, qvalue, geneID, Count)
xlsx::write.xlsx2(as.data.frame(kegg_enrichement_significant),
"../data/cluster_analysis/KEGG_Enrichement.xlsx",
sheetName = "kegg_enrichment",
col.names = TRUE,
row.names = TRUE,
append = FALSE,
showNA = TRUE)
xlsx::write.xlsx2(as.data.frame(mkegg_enrichement_significant),
"../data/cluster_analysis/KEGG_Enrichement.xlsx",
sheetName = "mkegg_enrichment",
col.names = TRUE,
row.names = TRUE,
append = TRUE,
showNA = FALSE)
